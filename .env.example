# Supabase project values from Dashboard → Connect. Do not put secret/service_role keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# 'none' = beta (phone is the unique identity, no SMS). 'sms' = one-time code via a Supabase phone provider.
EXPO_PUBLIC_PHONE_VERIFICATION=none

# Web Push (notifications on the iPhone home screen): the PUBLIC half of the VAPID key pair. The private half, PUSH_TOKEN and
# SUPABASE_SERVICE_ROLE_KEY live only in Netlify (see README → Notificaciones push).
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
