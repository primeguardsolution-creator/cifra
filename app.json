{
  "expo": {
    "name": "CIFRA",
    "slug": "cifra-mobile",
    "scheme": "cifra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cifra.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.cifra.mobile",
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CIFRA usa tus fotos y vídeos solo cuando eliges compartirlos.",
          "cameraPermission": "CIFRA usa la cámara solo cuando decides hacer una foto.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permite a CIFRA usar Face ID para proteger tu sesión."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/cifra-logo.png",
          "imageWidth": 150,
          "backgroundColor": "#F6F6FB",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ]
  }
}
